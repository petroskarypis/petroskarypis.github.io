source "https://rubygems.org"

# The gem set GitHub Pages builds with, so local previews match the live site.
# Needs Ruby 3.3 (brew install ruby@3.3); Ruby 4 can't build its dependencies.
gem "github-pages", group: :jekyll_plugins

# `jekyll serve` needs it on Ruby 3+, which no longer bundles it.
gem "webrick"
